[Unit]
Description=Hilleye (CyberSyn Intel) SS13 Tracker
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=hilleye
Group=hilleye
StateDirectory=hilleye
StateDirectoryMode=0750
WorkingDirectory=/opt/Hilleye
Environment="PATH=/opt/Hilleye/venv/bin"
Environment="HILLEYE_DB_PATH=/var/lib/hilleye/tracker.db"
ExecStart=/opt/Hilleye/venv/bin/python run.py
Restart=always
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/hilleye
UMask=0077

[Install]
WantedBy=multi-user.target
